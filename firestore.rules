rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myKey() {
      return request.auth.token.email.split('@')[0];
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@skorboard.test';
    }

    // Kullanıcılar: nick → hesap. Giriş yapan herkes okur (rakip seçmek için).
    match /users/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && myKey() == key
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'created'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nick is string
        && request.resource.data.nick.size() <= 20;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /boards/{b} {
      function boardData() {
        return get(/databases/$(database)/documents/boards/$(b)).data;
      }
      function inBoard() {
        return signedIn() && request.auth.uid in boardData().players;
      }
      function isSide(p) {
        return signedIn() && (
          (p == 'A' && boardData().players[0] == request.auth.uid) ||
          (p == 'B' && boardData().players[1] == request.auth.uid));
      }
      function validBoard(d) {
        return d.keys().hasOnly(['name', 'players', 'nicks', 'createdBy', 'created', 'status'])
          && d.name is string && d.name.size() <= 40
          && d.players is list && d.players.size() == 2
          && d.players[0] != d.players[1]
          && d.nicks is map
          && d.createdBy == request.auth.uid
          && d.created == request.time
          && d.status == 'active';
      }

      allow read: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.players);
      allow create: if isAdmin() && validBoard(request.resource.data)
        || (signedIn()
          && validBoard(request.resource.data)
          && request.resource.data.players[0] == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid in resource.data.players
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['active', 'done']);
      allow delete: if isAdmin();

      match /events/{id} {
        function validWin(d) {
          return d.keys().hasOnly(['type', 'player', 'n', 'by', 't'])
            && d.type == 'win'
            && d.player in ['A', 'B']
            && d.n in [1, 2];
        }
        function targetPath(d) {
          return /databases/$(database)/documents/boards/$(b)/events/$(d.target);
        }
        function validUndo(d) {
          return d.keys().hasOnly(['type', 'player', 'target', 'by', 't'])
            && d.type == 'undo'
            && d.target is string
            && id == 'undo-' + d.target
            && exists(targetPath(d))
            && get(targetPath(d)).data.type == 'win'
            && get(targetPath(d)).data.player == d.player;
        }
        function playerWrite(d) {
          return isSide(d.player)
            && d.by == d.player
            && d.t == request.time
            && boardData().status == 'active';
        }
        function adminWrite(d) {
          return isAdmin() && d.by == 'admin' && d.t is timestamp;
        }

        allow read: if isAdmin() || inBoard();
        allow update: if false;
        allow delete: if isAdmin();
        allow create: if (adminWrite(request.resource.data) || playerWrite(request.resource.data))
          && (validWin(request.resource.data) || validUndo(request.resource.data));
      }
    }
  }
}
