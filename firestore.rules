rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myKey() {
      return request.auth.token.email.split('@')[0];
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'admin@skorboard.test';
    }

    function validKey(k) {
      return k.matches('^[a-z0-9._]{3,20}$');
    }

    // Eski sürüm nick kayıtları: ilk girişte yeni yapıya taşınıp silinir.
    match /users/{key} {
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn()
        && myKey() == key
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'created'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Nick → hesap eşlemesi. Girişten önce okunur, bu yüzden tek tek okumaya açık.
    match /logins/{key} {
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn()
        && validKey(key)
        && (key != 'admin' || isAdmin())
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if false;
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Görünen nick. Herkes yalnız kendi profilini yazar; nick, kendisine ait bir eşlemeye bağlı olmalı.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'key'])
        && request.resource.data.nick is string
        && request.resource.data.nick.size() > 0
        && request.resource.data.nick.size() <= 20
        && existsAfter(/databases/$(database)/documents/logins/$(request.resource.data.key))
        && getAfter(/databases/$(database)/documents/logins/$(request.resource.data.key)).data.uid == uid;
      allow delete: if isAdmin();
    }

    match /boards/{b} {
      function boardData() {
        return get(/databases/$(database)/documents/boards/$(b)).data;
      }
      function inBoard() {
        return signedIn() && request.auth.uid in boardData().players;
      }
      function isSide(p) {
        return signedIn() && (
          (p == 'A' && boardData().players[0] == request.auth.uid) ||
          (p == 'B' && boardData().players[1] == request.auth.uid));
      }
      // Oyuncu renkleri: listeden seçilir, iki taraf aynı renk olamaz.
      function palette() {
        return ['#ff6fb1', '#ff5c5c', '#ff9a3c', '#ffd447', '#4be08a', '#2fd6d0', '#4aa8ff', '#b18cff', '#f4f1ff'];
      }
      function validColors(d) {
        return d.colors is map
          && d.colors.keys().hasOnly(['A', 'B'])
          && d.colors.A in palette()
          && d.colors.B in palette()
          && d.colors.A != d.colors.B;
      }
      function oldColor(side, def) {
        return resource.data.get('colors', {}).get(side, def);
      }
      // Oyuncu sadece kendi tarafının rengini değiştirebilir.
      function ownColorChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['colors'])
          && validColors(request.resource.data)
          && ((resource.data.players[0] == request.auth.uid
                && request.resource.data.colors.B == oldColor('B', '#4aa8ff'))
            || (resource.data.players[1] == request.auth.uid
                && request.resource.data.colors.A == oldColor('A', '#ff6fb1')));
      }
      function validBoard(d) {
        return d.keys().hasOnly(['name', 'players', 'nicks', 'createdBy', 'created', 'status', 'colors'])
          && (!('colors' in d) || validColors(d))
          && d.name is string && d.name.size() <= 40
          && d.players is list && d.players.size() == 2
          && d.players[0] != d.players[1]
          && d.nicks is map
          && d.createdBy == request.auth.uid
          && d.created == request.time
          && d.status == 'active';
      }

      allow read: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.players);
      allow create: if isAdmin() && validBoard(request.resource.data)
        || (signedIn()
          && validBoard(request.resource.data)
          && request.resource.data.players[0] == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid in resource.data.players
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                && request.resource.data.status in ['active', 'done'])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
                && request.resource.data.name is string
                && request.resource.data.name.size() <= 40)
            || ownColorChange()));
      allow delete: if isAdmin();

      match /events/{id} {
        function validWin(d) {
          return d.keys().hasOnly(['type', 'player', 'n', 'by', 't'])
            && d.type == 'win'
            && d.player in ['A', 'B']
            && d.n in [1, 2, 5, -1, -5];
        }
        function targetPath(d) {
          return /databases/$(database)/documents/boards/$(b)/events/$(d.target);
        }
        function validUndo(d) {
          return d.keys().hasOnly(['type', 'player', 'target', 'by', 't'])
            && d.type == 'undo'
            && d.target is string
            && id == 'undo-' + d.target
            && exists(targetPath(d))
            && get(targetPath(d)).data.type == 'win'
            && get(targetPath(d)).data.player == d.player;
        }
        function playerWrite(d) {
          return isSide(d.player)
            && d.by == d.player
            && d.t == request.time
            && boardData().status == 'active';
        }
        function adminWrite(d) {
          return isAdmin() && d.by == 'admin' && d.t is timestamp;
        }

        allow read: if isAdmin() || inBoard();
        allow update: if false;
        allow delete: if isAdmin();
        allow create: if (adminWrite(request.resource.data) || playerWrite(request.resource.data))
          && (validWin(request.resource.data) || validUndo(request.resource.data));
      }
    }
  }
}
