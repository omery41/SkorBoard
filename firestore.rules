rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function emailIs(e) {
      return signedIn() && request.auth.token.email == e;
    }
    function isAdmin() {
      return emailIs('admin@tavla.test');
    }
    function isPervin() {
      return emailIs('pervin@tavla.test');
    }
    function isEmin() {
      return emailIs('emin@tavla.test');
    }
    function isPlayer(p) {
      return (p == 'A' && isPervin()) || (p == 'B' && isEmin());
    }
    function adminWrite(d) {
      return isAdmin() && d.by == 'admin' && d.t is timestamp;
    }
    function playerWrite(d) {
      return isPlayer(d.player) && d.by == d.player && d.t == request.time;
    }
    function actorOk(d) {
      return adminWrite(d) || playerWrite(d);
    }
    function validWin(d) {
      return d.keys().hasOnly(['type', 'player', 'n', 'by', 't'])
        && d.type == 'win'
        && d.player in ['A', 'B']
        && d.n in [1, 2];
    }
    function targetPath(d) {
      return /databases/$(database)/documents/events/$(d.target);
    }
    function validUndo(id, d) {
      return d.keys().hasOnly(['type', 'player', 'target', 'by', 't'])
        && d.type == 'undo'
        && d.target is string
        && id == 'undo-' + d.target
        && exists(targetPath(d))
        && get(targetPath(d)).data.type == 'win'
        && get(targetPath(d)).data.player == d.player;
    }
    function validNames(d) {
      return d.keys().hasOnly(['A', 'B'])
        && d.A is string && d.A.size() <= 30
        && d.B is string && d.B.size() <= 30;
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin() && validNames(request.resource.data);
    }

    match /events/{id} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if actorOk(request.resource.data)
        && (validWin(request.resource.data) || validUndo(id, request.resource.data));
    }
  }
}
